NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# The coupon bond desk's issuer: the operator account every issuer-signed call is signed with
# (creating the stablecoin and demo investors, issuing/allocating/funding/starting/stopping a
# bond). HEDERA_OPERATOR_KEY must be ECDSA (raw hex, with or without 0x, or DER-encoded ECDSA);
# an ED25519 key is refused at start.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
